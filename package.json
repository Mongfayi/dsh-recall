{
  "name": "dsh-recall",
  "version": "0.3.0",
  "description": "Message recall (撤回) for the DSH Web UI: remove a message — and everything after it — from the conversation, durably, without ever reverting code changes. Requires DSH 0.2.0-rc.2.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": []
    }
  },
  "scripts": {
    "test": "node test/smoke-host.mjs && node test/smoke-durable.mjs && node test/smoke-client.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format-catalog": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.2.0-rc.2"
  }
}
